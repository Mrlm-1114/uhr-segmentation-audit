{
  "model": {
    "type": "EncoderDecoderRefine",
    "num_stages": 2,
    "pretrained": "weights/resnet18_v1c-b5776b93.pth",
    "down_ratio": 4,
    "backbone": {
      "type": "ResNetV1c",
      "depth": 18,
      "num_stages": 4,
      "out_indices": [
        0,
        1,
        2,
        3
      ],
      "dilations": [
        1,
        1,
        2,
        4
      ],
      "strides": [
        1,
        2,
        1,
        1
      ],
      "norm_cfg": {
        "type": "SyncBN",
        "requires_grad": true
      },
      "norm_eval": false,
      "style": "pytorch",
      "contract_dilation": true
    },
    "decode_head": [
      {
        "type": "RefineASPPHead",
        "in_channels": 512,
        "in_index": 3,
        "channels": 128,
        "dilations": [
          1,
          12,
          24,
          36
        ],
        "dropout_ratio": 0.1,
        "num_classes": 8,
        "norm_cfg": {
          "type": "SyncBN",
          "requires_grad": true
        },
        "align_corners": false,
        "loss_decode": {
          "type": "CrossEntropyLoss",
          "use_sigmoid": false,
          "loss_weight": 1
        }
      },
      {
        "type": "ISDHead",
        "in_channels": 3,
        "prev_channels": 128,
        "down_ratio": 4,
        "channels": 128,
        "num_classes": 8,
        "dropout_ratio": 0.1,
        "norm_cfg": {
          "type": "SyncBN",
          "requires_grad": true
        },
        "align_corners": false,
        "loss_decode": {
          "type": "CrossEntropyLoss",
          "use_sigmoid": false,
          "loss_weight": 1
        }
      }
    ],
    "auxiliary_head": {
      "type": "FCNHead",
      "in_channels": 256,
      "in_index": 2,
      "channels": 64,
      "num_convs": 1,
      "concat_input": false,
      "dropout_ratio": 0.1,
      "num_classes": 8,
      "norm_cfg": {
        "type": "SyncBN",
        "requires_grad": true
      },
      "align_corners": false,
      "loss_decode": {
        "type": "CrossEntropyLoss",
        "use_sigmoid": false,
        "loss_weight": 0.4
      }
    },
    "train_cfg": {},
    "test_cfg": {
      "mode": "whole"
    }
  },
  "data": {
    "samples_per_gpu": 2,
    "workers_per_gpu": 16,
    "train": {
      "pipeline": [
        {
          "type": "LoadImageFromFile"
        },
        {
          "type": "LoadAnnotations"
        },
        {
          "type": "Resize",
          "img_scale": [
            5120,
            5120
          ],
          "ratio_range": [
            1.0,
            1.0
          ]
        },
        {
          "type": "RandomCrop",
          "crop_size": [
            2560,
            2560
          ],
          "cat_max_ratio": 0.75
        },
        {
          "type": "RandomFlip",
          "prob": 0.5
        },
        {
          "type": "RandomRotate",
          "prob": 0.5,
          "degree": [
            90,
            270
          ]
        },
        {
          "type": "PhotoMetricDistortion"
        },
        {
          "type": "Normalize",
          "mean": [
            123.675,
            116.28,
            103.53
          ],
          "std": [
            58.395,
            57.12,
            57.375
          ],
          "to_rgb": true
        },
        {
          "type": "Pad",
          "size": [
            2560,
            2560
          ],
          "pad_val": 0,
          "seg_pad_val": 255
        },
        {
          "type": "DefaultFormatBundle"
        },
        {
          "type": "Collect",
          "keys": [
            "img",
            "gt_semantic_seg"
          ]
        }
      ],
      "data_root": "data/urur",
      "split": "external/urur_train.txt",
      "type": "CustomDataset",
      "img_dir": "images",
      "ann_dir": "labels",
      "img_suffix": ".png",
      "seg_map_suffix": ".png"
    }
  },
  "optimizer": {
    "type": "AdamW",
    "lr": 0.0002,
    "weight_decay": 0.0001
  },
  "runner": {
    "max_iters": 160000
  },
  "precision": "fp32",
  "cudnn_benchmark": false,
  "checkpoint_config": {
    "by_epoch": false,
    "interval": 2000,
    "max_keep_ckpts": 2,
    "save_last": true
  },
  "dataset": "urur",
  "family": "ISDNet",
  "seed": 0,
  "micro_batch": 2,
  "accumulation_steps": 4
}
